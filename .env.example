# ECHO Environment Variables (names only - never commit real values)

# --- Frontend (Next.js) ---
# Public values only. Anything here is visible in the browser bundle.
# NEVER prefix secrets (service-role key, encryption keys, AI tokens) with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_DATA_ADAPTER=mock

# Feature flags
NEXT_PUBLIC_ENABLE_BUDDY=true
NEXT_PUBLIC_ENABLE_FACIAL_ANALYSIS=false
NEXT_PUBLIC_ENABLE_RISK_INSIGHTS=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_DATA_EXPORT=true

# --- Backend (Express API) ---
# Full list: see backend/.env.example
