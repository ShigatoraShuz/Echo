# Root Docker Compose environment contract. Copy to an ignored .env and fill
# values locally. Never commit real credentials or copy them into examples.

# Supabase project. The publishable key is safe for the browser; the general
# service-role key is privileged and belongs to API Gateway only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# Distinct server-only JWT/API keys whose role claims match the service role.
# Never reuse SUPABASE_SERVICE_ROLE_KEY for any of these values.
USER_SERVICE_DATABASE_KEY=
USER_STORAGE_KEY=
JOURNAL_SERVICE_DATABASE_KEY=
ASSESSMENT_SERVICE_DATABASE_KEY=
ANALYSIS_SERVICE_DATABASE_KEY=
RECOMMENDATION_SERVICE_DATABASE_KEY=
WELLNESS_SERVICE_DATABASE_KEY=

# Unique target-service secrets (32+ random characters). Do not reuse a value
# between variables. Compose gives callers only tokens required by service-map.
USER_SERVICE_TOKEN=
JOURNAL_SERVICE_TOKEN=
ASSESSMENT_SERVICE_TOKEN=
ANALYSIS_SERVICE_TOKEN=
ML_SERVICE_TOKEN=
RECOMMENDATION_SERVICE_TOKEN=
WELLNESS_SERVICE_TOKEN=
INSIGHTS_SERVICE_TOKEN=

# Existing AES-256-GCM compatibility contract. Preserve the current key bytes
# and version when migrating encrypted journals and related legacy ciphertext.
JOURNAL_ENCRYPTION_KEY_BASE64=
JOURNAL_ENCRYPTION_KEY_VERSION=1

# Frontend build-time behavior. No privileged value may use NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_DATA_ADAPTER=http
NEXT_PUBLIC_ENABLE_BUDDY=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_DATA_EXPORT=true

# Service-owned operational settings.
APP_ENV=development
GATEWAY_REQUEST_TIMEOUT_MS=5000
WELLNESS_REQUEST_TIMEOUT_MS=5000
INSIGHTS_REQUEST_TIMEOUT_MS=5000
ANALYSIS_REQUEST_TIMEOUT_SECONDS=10
ANALYSIS_LOG_LEVEL=INFO
ANALYSIS_RATE_LIMIT_PER_MINUTE=60
ANALYSIS_RATE_LIMIT_WINDOW_SECONDS=60

# ML-owned, non-secret model configuration. Artifacts remain outside Git.
ML_BASE_MODEL_ID=microsoft/Phi-4-mini-instruct
ML_MODEL_VERSION=phi4-mini-echo-v1
ML_DEVICE=cpu
MODEL_ARTIFACTS_PATH=./ml/model-artifacts
