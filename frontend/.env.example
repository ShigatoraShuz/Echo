# --- Authentication (Supabase) -------------------------------------------------
# Identity provider only. Auth adapter selection follows NEXT_PUBLIC_DATA_ADAPTER:
#   "mock" = in-memory dev accounts (no network)
#   "http" = Supabase when the variables below are set, otherwise the Express
#            API adapter ("not yet connected"), or a hard "not configured"
#            failure in production. Never place a service-role key in this file.
# Google Identity Services Web application client. The backend must use the
# same ID in GOOGLE_WEB_CLIENT_ID, and Supabase Auth's Google provider must
# accept that same ID. In Google Cloud Console, add every exact
# development origin under Authorized JavaScript origins (origins have no path):
#   http://127.0.0.1:3000
# Google treats localhost and 127.0.0.1 as distinct origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Add the frontend callback URL to Supabase Auth redirect allow-list:
#   http://127.0.0.1:3000/callback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_ENABLE_ANALYSIS_FIXTURES=false

# Use the Express API for all authenticated application data.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4200/api/v1
NEXT_PUBLIC_DATA_ADAPTER=http

NEXT_PUBLIC_ENABLE_BUDDY=true
NEXT_PUBLIC_ENABLE_FACIAL_ANALYSIS=false
NEXT_PUBLIC_ENABLE_RISK_INSIGHTS=false
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=false
NEXT_PUBLIC_ENABLE_IN_APP_REMINDERS=false
NEXT_PUBLIC_ENABLE_EMAIL_ALERTS=false
# Public VAPID key only. Set after the push worker and backend VAPID keys are ready.
NEXT_PUBLIC_PUSH_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_ENABLE_DATA_EXPORT=false
