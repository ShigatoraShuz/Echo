{
  "name": "echo-theme-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e:mobile": "playwright test --config playwright.mobile.config.ts",
    "test:e2e:routes": "node scripts/check-route-manifest.mjs",
    "test:e2e:staging": "playwright test --config playwright.staging.config.ts",
    "test:e2e:staging:core": "npm run test:e2e:routes && node scripts/run-staging-core.mjs",
    "test:e2e:record": "node scripts/create-release-record.mjs",
    "verify:google-origin": "node scripts/verify-google-origin.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:professional": "playwright test --config playwright.professional.config.ts"
  },
  "dependencies": {
    "@echo/contracts": "0.1.0",
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "framer-motion": "^12.42.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lenis": "^1.3.25",
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.4",
    "jest-axe": "^11.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "5.8.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
