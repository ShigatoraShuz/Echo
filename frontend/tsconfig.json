{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "tsBuildInfoFile": ".next/cache/tsconfig.tsbuildinfo",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-qa/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-native-local/types/**/*.ts",
    ".next-native-local/dev/types/**/*.ts",
    ".next-native-build/types/**/*.ts",
    ".next-native-build/dev/types/**/*.ts",
    ".next-ui-polish-build/types/**/*.ts",
    ".next-ui-polish-build/dev/types/**/*.ts",
    ".next-private/types/**/*.ts",
    ".next-private/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
