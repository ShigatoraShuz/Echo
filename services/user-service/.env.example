PORT=4201
# Explicit local-only insecure-cookie exception; Docker production keeps Secure.
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server-only JWT/API key whose role claim is user_service_role.
SUPABASE_DATABASE_KEY=
# Server-only JWT/API key whose role claim is user_storage_role. This role is
# RLS-restricted to the private verification-documents and avatars buckets.
USER_STORAGE_KEY=
USER_SERVICE_TOKEN=
REGISTRATION_HMAC_SECRET=
GOOGLE_WEB_CLIENT_ID=
JOURNAL_ENCRYPTION_KEY_BASE64=
JOURNAL_ENCRYPTION_KEY_VERSION=1
