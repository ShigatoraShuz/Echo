APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Analysis validates its inbound gateway identity with its own token and holds
# only the target tokens required by its documented outbound calls.
ANALYSIS_SERVICE_TOKEN=
USER_SERVICE_TOKEN=
JOURNAL_SERVICE_TOKEN=
ML_SERVICE_TOKEN=
RECOMMENDATION_SERVICE_TOKEN=
SUPABASE_URL=https://your-project.supabase.co
# Server-only JWT/API key whose role claim is analysis_service_role.
SUPABASE_DATABASE_KEY=
USER_SERVICE_URL=http://localhost:4201
JOURNAL_SERVICE_URL=http://localhost:4202
ML_SERVICE_URL=http://localhost:8001
RECOMMENDATION_SERVICE_URL=http://localhost:4205
REQUEST_TIMEOUT_SECONDS=10

LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60
