APP_ENV=development
HOST=127.0.0.1
PORT=8000

AI_SERVICE_TOKEN=
# The local launcher sets these and generates credentials without editing this file.
CORE_MODELS_ENABLED=false
MODELS_ROOT=../../models
WORKER_ENABLED=false
BACKEND_URL=http://127.0.0.1:4200/api/v1/internal/ai
AI_WORKER_TOKEN=
# Legacy disabled-scaffold metadata below; not used by the core model runtime.
BASE_MODEL_ID=microsoft/Phi-4-mini-instruct
LORA_ADAPTER_PATH=/models/echo-adapter
MODEL_VERSION=phi4-mini-echo-v1

MAX_INPUT_TOKENS=384
MAX_NEW_TOKENS=64
DEVICE=cuda
TORCH_DTYPE=bfloat16

LOG_LEVEL=INFO
