APP_ENV=development
HOST=127.0.0.1
PORT=8000

AI_SERVICE_TOKEN=
# Safe defaults. Opt into text_memory only with the reviewed local launcher.
# The retained native launcher is not the standard application startup.
CORE_MODELS_ENABLED=false
CORE_TRANSPORT=disabled
CORE_REQUEST_TIMEOUT_SECONDS=270
# Default: this checkout's backend/models, independent of the working directory.
# Optional explicit absolute override (does not enable models):
# MODELS_ROOT=C:/absolute/path/to/Echo/backend/models
WORKER_ENABLED=false
BACKEND_URL=http://127.0.0.1:4200/api/v1/internal/ai
AI_WORKER_TOKEN=
# Legacy disabled-scaffold metadata below; not used by the core model runtime.
BASE_MODEL_ID=microsoft/Phi-4-mini-instruct
LORA_ADAPTER_PATH=/models/echo-adapter
MODEL_VERSION=phi4-mini-echo-v1

MAX_INPUT_TOKENS=384
MAX_NEW_TOKENS=64
DEVICE=cuda
TORCH_DTYPE=bfloat16

LOG_LEVEL=INFO
