# ECHO Backend Environment (names only - never commit real values)
# Copy to .env and fill with real values.

NODE_ENV=development

# Port the API listens on
PORT=4200

# Origin of the Next.js frontend (used for the CORS allow-list)
FRONTEND_URL=http://localhost:3000

# Supabase project configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
# Server-side only. NEVER expose in frontend bundles or NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Must exactly match frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID. Register the
# frontend's exact origin in this Web client's Authorized JavaScript origins.
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# At least 32 random characters. Used only to hash short-lived signup credentials.
SIGNUP_DRAFT_SECRET=

# AES-256-GCM key for journal/PHQ/message encryption at rest.
# Must decode from base64 to exactly 32 bytes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JOURNAL_ENCRYPTION_KEY_BASE64=
JOURNAL_ENCRYPTION_KEY_VERSION=1
# JSON mapping approved previous versions to distinct base64 keys. Never public.
ENCRYPTION_PREVIOUS_KEYS_JSON={}

# disabled | development_stub | local_worker. No real model is bundled.
AI_ANALYSIS_MODE=disabled
AI_DEVELOPMENT_USER_IDS=
AI_WORKER_TOKEN=
AI_STUB_CONCURRENCY=1
AI_JOB_TIMEOUT_MS=60000

# Rotate by adding a new version, switching active version, and retaining old
# secrets for at least the 24-hour replay window.
IDEMPOTENCY_HMAC_ACTIVE_VERSION=v1
IDEMPOTENCY_HMAC_KEYS_JSON={"v1":"replace-with-at-least-32-random-characters"}

# Optional tuning
REQUEST_TIMEOUT_MS=30000
LOG_LEVEL=info
REQUEST_BODY_LIMIT=1mb
# Explicit IPs/CIDRs of actual reverse proxies; empty means direct connections.
TRUSTED_PROXY_ADDRESSES=
# Operator-managed local JSON, atomically replaced for emergency shutdown.
ECHO_SECURITY_CONTROLS_FILE=

# Persisted wellness scheduling (days); use PHQ8_INTERVAL_DAYS=3 for demos.
PHQ8_INTERVAL_DAYS=7
SUPPORT_PROMPT_THRESHOLD=3
SUPPORT_PROMPT_WINDOW_DAYS=14
SUPPORT_PROMPT_COOLDOWN_DAYS=7
